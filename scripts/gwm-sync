#!/usr/bin/env bash
# gwm-sync — reconcile this working tree with the private GitHub record.
#
# Runs from EITHER side: the laptop or the SuperPOD login node.  It stages local
# additions and modifications, rebases onto whatever the other side pushed, then
# pushes.  Because it is git rather than rsync, concurrent edits on both sides
# merge instead of one side silently clobbering the other — which is what the
# project's old push-only rsync rule existed to prevent.
#
# Two flag details that cost real debugging time, recorded so they are not undone:
#
#   * `git add --ignore-removal .` is deliberate.  The laptop and the cluster hold
#     overlapping but NOT identical trees; each has files the other has never had.
#     A plain `git add -A` on one machine stages the other machine's files as
#     deletions and erases them on the next sync.  Real deletions must be done
#     explicitly with `git rm`.
#   * It must be `--ignore-removal .` and NOT `-A --ignore-removal`.  The two flags
#     are mutually exclusive and the later one wins; with `-A` last, removals are
#     staged anyway, and with `--ignore-removal` last and no pathspec git prints
#     "Nothing specified, nothing added" and stages NOTHING — a silent no-op.
#
# Usage:  scripts/gwm-sync ["commit message"]
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || { echo "not inside a git repo"; exit 1; }
HOST="$(hostname -s)"
MSG="${1:-sync from ${HOST}: $(date -u +%FT%TZ)}"
STAGE=(git add --ignore-removal .)

# ---- fail-closed staleness guard (added 2026-09-19 after a real near-loss) ---
# The original order was: commit, THEN fetch.  On a machine whose worktree is
# behind, `git add --ignore-removal .` stages the older copies as MODIFICATIONS,
# so the commit is an accidental revert of the newer side, and the rebase then
# replays that revert on top of origin/main.  On 2026-09-19 the login node was
# three days behind and a sync produced a commit deleting a whole principles
# section, which only a manual diff caught.  Fetch first; never commit from a
# behind HEAD that also has local modifications.
# ---- concurrent-writer guard (added 2026-09-19 after a real loss) ---------
# A background `codex exec` holding workspace-write can rewrite tracked files
# while this script runs.  On 2026-09-19 that happened: a still-running review
# process reverted RESEARCH_MEMORY.md to the copy it had read, this script
# staged the reversion, and the resulting commit silently deleted 45 lines of
# ledger under the message "add consolidated closeout document".  The staleness
# guard below does not catch this: the tree was not behind origin, it was being
# mutated locally.  Refuse to sync while such a process is alive.
if command -v pgrep >/dev/null 2>&1; then
  CODEX_PIDS="$(pgrep -f 'codex exec' 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "${CODEX_PIDS}" ]; then
    echo "REFUSING TO SYNC: a codex process with workspace-write is still running (pid: ${CODEX_PIDS})."
    echo "It can rewrite tracked files mid-commit and the reversion would be staged silently."
    echo "Wait for it to exit, then re-run.  To inspect: ps -p ${CODEX_PIDS}"
    exit 8
  fi
fi

echo "[${HOST}] fetching origin/main ..."
git fetch -q origin main || { echo "[${HOST}] fetch failed"; exit 5; }
BEHIND=$(git rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)
if [ "${BEHIND}" -gt 0 ]; then
  if [ -n "$(git status --porcelain)" ]; then
    echo "REFUSING TO SYNC: ${BEHIND} commit(s) behind origin/main AND the tree is dirty."
    echo "Committing now would stage stale copies as reverts of newer content."
    echo "Do this instead, then re-run:"
    echo "  git stash && git pull --rebase origin main && git stash pop"
    echo "Inspect every conflict by hand.  Prefer the newer side unless the local"
    echo "change is genuinely new work that the other machine has never seen."
    exit 6
  fi
  echo "[${HOST}] behind by ${BEHIND}; fast-forwarding before staging"
  git merge --ff-only FETCH_HEAD || { echo "[${HOST}] cannot fast-forward; resolve by hand"; exit 7; }
fi

# ---- refuse to stage anything that must never leave the machine -------------
BLOCK='(\.credentials|credentials\.(yaml|json)|^\.env$|\.pem$|\.key$|id_rsa|id_ed25519|node_modules/|^data/|^results/)'
"${STAGE[@]}" -n 2>/dev/null | sed "s/^add //;s/^remove //" | tr -d "'" \
  | grep -E "$BLOCK" > "/tmp/gwm_sync_blocked.$$" 2>/dev/null
if [ -s "/tmp/gwm_sync_blocked.$$" ]; then
  echo "REFUSING TO SYNC: these paths match the never-commit list:"
  sed 's/^/  /' "/tmp/gwm_sync_blocked.$$"
  echo "Fix .gitignore first."
  rm -f "/tmp/gwm_sync_blocked.$$"; exit 2
fi
rm -f "/tmp/gwm_sync_blocked.$$"

# ---- refuse oversized blobs -------------------------------------------------
BIG=$("${STAGE[@]}" -n 2>/dev/null | sed "s/^add //" | tr -d "'" \
      | while read -r f; do [ -f "$f" ] && [ "$(wc -c <"$f")" -gt 20971520 ] && echo "$f"; done)
if [ -n "$BIG" ]; then
  echo "REFUSING TO SYNC: files larger than 20 MB would be committed:"
  echo "$BIG" | sed 's/^/  /'; exit 3
fi

"${STAGE[@]}"
if git diff --cached --quiet; then
  echo "[${HOST}] nothing local to commit"
else
  echo "[${HOST}] staging $(git diff --cached --name-only | wc -l | tr -d ' ') file(s)"
  git commit -q -m "$MSG" && echo "[${HOST}] committed: $MSG"
fi

echo "[${HOST}] rebasing onto origin/main ..."
if ! git pull --rebase --autostash origin main; then
  echo "[${HOST}] REBASE CONFLICT. Resolve, then: git rebase --continue && git push origin main"
  exit 4
fi

git push origin main && echo "[${HOST}] pushed. $(git rev-parse --short HEAD)"
