/dx xx2 xx1 sub def
dx 0 ne {
	/drdx xr2 xr1 sub dx div def
	/dgdx xg2 xg1 sub dx div def
	/dbdx xb2 xb1 sub dx div def
}{
	/drdx 0 def
	/dgdx 0 def
	/dbdx 0 def
} ifelse
/len dx 1 add cvi 3 mul def
len string dup dup
xr1 drdx 3 -1 roll
0 3 len 1 sub { incr } for
pop pop pop
xg1 dgdx 3 -1 roll
1 3 len 1 sub { incr } for
pop pop pop
xb1 dbdx 3 -1 roll
2 3 len 1 sub { incr } for
3 1 roll pop pop
} bind def
