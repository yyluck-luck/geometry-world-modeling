      "patch": "@@ -0,0 +1,19 @@\n+# RayMap3R inference requirements (tested configuration).\n+# PyTorch with CUDA must match your system; install it first from https://pytorch.org.\n+torch==2.1.1\n+torchvision==0.16.1\n+numpy==1.26.4\n+einops==0.6.1\n+transformers>=4.40.0\n+huggingface-hub\n+safetensors\n+opencv-python\n+pillow\n+imageio\n+imageio-ffmpeg\n+scipy\n+tqdm\n+plyfile\n+roma\n+# The CroCo v2 RoPE CUDA extension (src/croco/models/curope) must be built once:\n+#   cd src/croco/models/curope && python setup.py build_ext --inplace"
    },
