      "patch": "@@ -0,0 +1,23 @@\n+# weights (download separately — see README)\n+weights/*.pth\n+weights/*.safetensors\n+\n+# python\n+__pycache__/\n+*.py[cod]\n+*.egg-info/\n+.ipynb_checkpoints/\n+\n+# build artifacts (CUDA extension)\n+*.so\n+src/croco/models/curope/build/\n+\n+# outputs / scratch\n+results/\n+output/\n+*.ply\n+*.glb\n+*.log\n+\n+# os\n+.DS_Store"
