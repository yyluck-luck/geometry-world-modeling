+            "stdout_bytes": len(result.stdout),
+            "stderr_bytes": len(result.stderr),
+            "stdout_sha256": sha256_bytes(result.stdout),
+            "stderr_sha256": sha256_bytes(result.stderr),
+            "stdout_text": result.stdout.decode("utf-8"),
+            "stderr_text": result.stderr.decode("utf-8"),
+            "complete_exact_external_json": exact,
+            "accepted_only_with_external_exit_zero": accepted,
+        })
+    return {
+        "status": "PASS_SHARED_PRODUCTION_EMIT_FLUSH_AND_EXTERNAL_EXIT_ROUNDTRIP",
+        "cases": records,
+        "formal_supervision_calls": 0,
+        "real_camera_or_image_body_bytes_read": 0,
+    }
 
 
