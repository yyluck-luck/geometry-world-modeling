+def synthetic_emission_roundtrip():
+    """Observe the actual shared emitter's complete JSON and OS exit from outside."""
+    records = []
+    worker_sha = sha256_bytes(WORKER.read_bytes())
+    for mode in ("NORMAL", "SHORT_WRITE", "WRITE_ERROR",
+                 "PARTIAL_WRITE_ERROR", "FLUSH_ERROR"):
+        result = subprocess.run(
+            [str(PYTHON_EXECUTABLE), "-I", "-B", "-S", str(SELF),
+             "--synthetic-emission-child", mode],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10,
+            check=False,
+        )
+        require(len(result.stdout) <= MAX_STDOUT_BYTES
+                and len(result.stderr) <= 4096,
+                "Synthetic emission exceeded its bounded output")
+        try:
+            parsed = json.loads(result.stdout)
+        except (ValueError, UnicodeDecodeError):
+            parsed = None
+        exact = False
+        if isinstance(parsed, dict):
+            expected = build_external_pass_seal(
+                parsed.get("held_candidate_observation"), "c" * 64,
+                worker_sha, parsed.get("attempt_lock_sha256"), "2" * 64,
+            )
+            exact = parsed == expected and encoded_json(expected) == result.stdout
+        accepted = result.returncode == 0 and result.stderr == b"" and exact
+        if mode in ("NORMAL", "SHORT_WRITE"):
+            require(accepted, "Shared production emitter failed ordinary " + mode)
+        else:
+            require(result.returncode == 2 and not accepted,
+                    "A writer/flush failure was accepted as success")
+            failure = json.loads(result.stderr)
+            require(encoded_json(failure) == result.stderr
+                    and failure.get("schema") == "s45b-c1-supervisor-stderr-failure-v1"
+                    and failure.get("failed_phase") == "EXTERNAL_HELD_FD_AUTHORITY_EMISSION"
+                    and failure.get("error_type") == "OSError"
+                    and failure.get("passed") is False
+                    and failure.get("terminal_authority") is False,
+                    "Post-close failure did not emit its bounded original-error diagnostic")
+            if mode == "WRITE_ERROR":
+                require(result.stdout == b"", "Initial write failure emitted bytes")
+            if mode == "PARTIAL_WRITE_ERROR":
+                require(result.stdout and not exact,
+                        "Partial-write failure did not leave an invalid prefix")
+            if mode == "FLUSH_ERROR":
+                require(exact,
+                        "Flush-error control must show full JSON still fails without exit zero")
+        records.append({
