+def synthetic_controlled_emission(worker, observation, worker_sha, lock_sha, mode):
+    """Inject only finite ordinary stdout faults in a disposable child process."""
+    require(mode in ("NORMAL", "SHORT_WRITE", "WRITE_ERROR",
+                     "PARTIAL_WRITE_ERROR", "FLUSH_ERROR"),
+            "Unknown synthetic emission mode")
+    stdout_fd = sys.stdout.fileno()
+    original_write = os.write
+    writes = 0
+
+    def controlled_write(fd, body):
+        nonlocal writes
+        if fd != stdout_fd:
+            return original_write(fd, body)
+        writes += 1
+        if mode == "WRITE_ERROR" or (mode == "PARTIAL_WRITE_ERROR" and writes > 1):
+            raise OSError(errno.EIO, "synthetic stdout write failure")
+        if mode == "SHORT_WRITE":
+            return original_write(fd, body[:17])
+        if mode == "PARTIAL_WRITE_ERROR":
+            return original_write(fd, body[:7])
+        return original_write(fd, body)
+
+    def failed_flush():
+        raise OSError(errno.EIO, "synthetic stdout flush failure")
+
+    stream = (
+        types.SimpleNamespace(fileno=sys.stdout.fileno, flush=failed_flush)
+        if mode == "FLUSH_ERROR" else sys.stdout
+    )
+    try:
+        os.write = controlled_write
+        result = emit_external_pass_seal(
+            worker, observation, "c" * 64, worker_sha, lock_sha, "2" * 64,
+            stream=stream,
+        )
+        if mode == "SHORT_WRITE":
+            require(writes > 1, "Short-write case did not exercise repeated writes")
+        return result
+    finally:
+        os.write = original_write
+
+
