# --- Measured access accounting (replaces the previous hardcoded receipt flags) ---
# CPython raises the 'open' audit event for builtins.open, io.open and os.open, so
# this observes library reads too, not only reads this wrapper performs itself.
# Roots the boundary legitimately exposes; anything else is recorded verbatim.
ALLOWED_OPEN_ROOTS=tuple(str(Path(p)) for p in (
    sys.prefix, RUN, WEIGHTS, STAGE, OUT, BUNDLE,
    '/usr','/lib','/lib64','/bin','/sbin','/etc','/proc','/sys','/dev','/run','/tmp','/var','/opt'))
# Roots that must never be reachable: the unmounted project tree and dataset archive.
FORBIDDEN_OPEN_ROOTS=('/home/yliutz/geometry-world-modeling','/home/yliutz/datasets')
# The audit event fires BEFORE the open, so an attempt to a path that does not
# exist is still recorded.  Only forbidden-root attempts are treated as failures;
# out-of-root attempts (e.g. a library probing an unmounted cache dir) are
# recorded verbatim for the reviewer but do not by themselves fail the seal.
OPEN_LOG={'outside':[], 'forbidden':[]}
OPEN_LOG_CAP=64
def _audit(event, args):
    if event!='open': return
    try: target=os.fspath(args[0])
    except (TypeError, ValueError, IndexError): return
    if not isinstance(target,str) or not target.startswith('/'): return
    bucket='forbidden' if target.startswith(FORBIDDEN_OPEN_ROOTS) else (
        None if target.startswith(ALLOWED_OPEN_ROOTS) else 'outside')
    if bucket is None: return
    log=OPEN_LOG[bucket]
    if target not in log and len(log)<OPEN_LOG_CAP: log.append(target)
sys.addaudithook(_audit)

