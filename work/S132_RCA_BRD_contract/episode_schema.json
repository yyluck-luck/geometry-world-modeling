{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gwm://s132/rca-brd-episode-schema-v1",
  "title": "S132 RCA BRD episode contract",
  "type": "object",
  "required": ["contract_id", "status", "episodes", "future_scoring_permitted"],
  "properties": {
    "contract_id": {"const": "S132_RCA_BRD_CPU_V1"},
    "status": {"const": "CONTRACT_ONLY"},
    "new_method_validated": {"const": false},
    "novelty_authorization": {"const": "NONE"},
    "future_scoring_permitted": {"const": false},
    "episodes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["episode_id", "context", "pre_reveal_query", "reveal", "future_queries", "independent_geometry_mask_sha256"],
        "properties": {
          "episode_id": {"type": "string", "minLength": 1},
          "context": {"type": "array", "minItems": 4, "maxItems": 4},
          "pre_reveal_query": {"type": "object"},
          "reveal": {"type": "object"},
          "future_queries": {"type": "array", "minItems": 2},
          "independent_geometry_mask_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rca_cases": {"type": "array", "minItems": 4, "maxItems": 4},
          "brd_pair": {"type": "object", "required": ["positive", "negative"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
