<th id="S3.T2.3.1.1" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.3.1.1.1" class="ltx_text" style="font-size:80%;">Environment</span></th>
<th id="S3.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.3.1.2.1" class="ltx_text" style="font-size:80%;">Camera type</span></th>
<th id="S3.T2.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.3.1.3.1" class="ltx_text" style="font-size:80%;">Lighting</span></th>
<th id="S3.T2.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.3.1.4.1" class="ltx_text" style="font-size:80%;"># scenes</span></th></tr>
</thead>
