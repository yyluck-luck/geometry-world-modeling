<td id="S5.T6.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.3.1.3.4.1" class="ltx_text" style="font-size:80%;">6.86</span></td>
<td id="S5.T6.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.3.1.3.5.1" class="ltx_text" style="font-size:80%;">0.15</span></td></tr>
<tr id="S5.T6.3.1.4" class="ltx_tr">
