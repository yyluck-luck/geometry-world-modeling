# ---- credentials and environment: never commit ----
**/.credentials*
**/credentials.yaml
**/credentials.json
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.netrc

# ---- bulk data, deliberately local-only (see docs/RESEARCH_HANDOFF_CURRENT.md) ----
data/
results/
tmp/

# ---- third-party runtimes and caches ----
**/node_modules/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.venv/
venv/

# ---- large binary artefacts: the scientific record is the JSON receipt, not the blob ----
*.npz
*.npy
*.pth
*.ckpt
*.safetensors
*.sif
*.tar
*.tgz
*.tar.gz
*.zip
*.mp4
*.avi
*.pdf.bak

# ---- build products ----
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# ---- more binary artefacts found on first sync ----
*.bin
*.pt
*.pkl
*.h5
*.hdf5
*.parquet
*.webm
*.mov
# LaTeX build trees; the committed PDF is docs/report/latex/report.pdf
**/report/build/
**/build/run_*/

# ---- vendored environments and third-party binaries ----
**/site-packages/
**/binaries/
*.csv

# ---- PDFs: the record is the source, not the rendered artefact.
#      The one finalised deliverable is force-included below.
*.pdf
!docs/report/latex/report.pdf

# ---- wheels, notebooks with embedded outputs, large figures ----
**/wheelhouse/
*.whl
*.ipynb
*.png
*.jpg
*.jpeg
*.svg
*.gif

# ---- virtual environments (any naming) ----
.venv*/
*-venv/
env/

# NFS silly-rename artifacts (created when an open file is replaced over NFS;
# the cluster committed one on 2026-09-19 via `git add --ignore-removal .`)
.nfs*
**/.nfs*
