# ---- credentials and environment: never commit ----
**/.credentials*
**/credentials.yaml
**/credentials.json
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.netrc

# ---- bulk data, deliberately local-only (see docs/RESEARCH_HANDOFF_CURRENT.md) ----
data/
results/
tmp/

# ---- third-party runtimes and caches ----
**/node_modules/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.venv/
venv/

# ---- large binary artefacts: the scientific record is the JSON receipt, not the blob ----
*.npz
*.npy
*.pth
*.ckpt
*.safetensors
*.sif
*.tar
*.tgz
*.tar.gz
*.zip
*.mp4
*.avi
*.pdf.bak

# ---- build products ----
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
