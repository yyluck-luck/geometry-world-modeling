gn=middle;fontFamily=PingFang SC;fontSize=26;fontColor=#17212B;strokeWidth=2;spacing=12;fillColor=#FFF1DC;strokeColor=#B46C00;" vertex="1" parent="1"><mxGeometry as="geometry" x="795" y="465" width="250" height="145" /></mxCell><mxCell id="selector" value="&lt;b&gt;H3 选择规则&lt;/b&gt;&lt;br&gt;如何挑4张图" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontColor=#17212B;strokeWidth=2;spacing=12;fillColor=#F4EAF1;strokeColor=#8B4E7A;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="325" width="205" height="125" /></mxCell><mxCell id="references" value="4张参考图&lt;br&gt;先封存选择" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontColor=#17212B;strokeWidth=2;spacing=12;fillColor=#F1F3F5;strokeColor=#68737D;" vertex="1" parent="1"><mxGeometry as="geometry" x="1370" y="332" width="180" height="112" /></mxCell><mxCell id="score" value="支持 / 误差评分&lt;br&gt;分别报告，不混成一个结论" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontColor=#17212B;strokeWidth=2;spacing=12;fillColor=#EEF2F5;strokeColor=#46545F;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="685" width="300" height="110" /></mxCell><mxCell id="measurement" value="外部实测 depth / GT&lt;br&gt;只在评分时读取" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontColor=#17212B;strokeWidth=2;spacing=12;fillColor=#FAFAFA;strokeColor=#46545F;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="685" width="300" height="110" /></mxCell><mxCell id="title" value="下一轮：分开位置、关联和选图规则" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=42;fontColor=#17212B;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="24" width="1500" height="68" /></mxCell><mxCell id="subtitle" value="计划机制图｜H1、H2、H3 是待区分的竞争解释" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=25;fontColor=#51606B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="99" width="1110" height="45" /></mxCell><mxCell id="h2note" value="H2 同时涉及来源与点数量，不能解释成只改来源ID。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=25;fontColor=#75501B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="526" width="640" height="60" /></mxCell><mxCell id="phase" value="选图完成之后 → 才使用外部测量进行评分" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=26;fontColor=#17212B;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="665" width="740" height="52" /></mxCell><mxCell id="gtdef" value="GT：参考相机轨迹。实测深度和GT均不进入建图或选图。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=23;fontColor=#51606B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="728" width="740" height="68" /></mxCell><mxCell id="footnote" value="竞争解释，可同时存在；计划消融，尚未证明哪项主导。S6已有结果不等于完整VMem视频。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=25;fontColor=#46545F;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="836" width="1540" height="48" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#46545F;fontFamily=PingFang SC;fontSize=22;fontColor=#46545F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rgb" target="predict"><mxGeometry as="geometry" relative="1" /></mxCell><mx